; Engine configuration file.
; Faithful baseline: 650x450 internal Flash-compatible viewport at a 30 Hz simulation tick.
config_version=5

[application]

config/name="Reign of Centipede — Faithful Recreation"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

[display/window]

size/viewport_width=650
size/viewport_height=450
; Keep the 650x450 Flash-native canvas at an integer pixel-art scale.  The
; previous 1.5x override produced uneven pixel widths that made the original
; artwork look subtly soft and proportionally inconsistent on screen.
size/window_width_override=1300
size/window_height_override=900
stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=30
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
